# Local dev: VITE_API_URL is relative so requests hit the Vite proxy in vite.config.ts,
# which forwards /api/... → http://localhost:8080/api/... unchanged. No rewrite is needed:
# the backend mounts every JAX-RS resource under /api via @ApplicationPath("api")
# (fr/alb/TosBeApplication.java), not via quarkus.http.root-path.
VITE_API_URL=/api
VITE_FEATURE_ADOBE_EXPRESS=true
VITE_GJS_STUDIO_KEY=c5707d6302f747e2ac8842563bfc8cc235b3ee16c9a348e0bbd5963ef0c7769b

# Azure AD Authentication (Development - uses same credentials as production)
VITE_AZURE_AD_CLIENT_ID=7e6ac0af-7c14-4469-8dcc-925924ef3c97
VITE_AZURE_AD_AUTHORITY=https://login.microsoftonline.com/17a64cff-61e7-4589-bbe0-c0989d8f625c
VITE_AZURE_AD_SCOPES=api://7e6ac0af-7c14-4469-8dcc-925924ef3c97/.default
VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173

# ── Connexion locale id/mot de passe — LOCAL TASOpensid ─────────────────────
# Ne pas répliquer vers pigch/FactFront. Ce fichier n'est charge que par
# `npm run dev` (mode development) ; `npm run build` ne le lit jamais.
# À utiliser avec `./start.sh --no-auth` : le jeton produit est un marqueur
# local que le back ne peut pas vérifier.
VITE_DEV_LOCAL_LOGIN=true
VITE_DEV_LOCAL_USERNAME=devuser
VITE_DEV_LOCAL_PASSWORD=devpass123
VITE_DEV_LOCAL_ROLES=ROLE_ADMIN,ROLE_USER
